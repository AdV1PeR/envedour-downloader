# Telegram bot token from @BotFather
BOT_TOKEN=

# Number of download workers
WORKER_COUNT=4

# Temporary storage for downloads (tmpfs is recommended)
TMPFS_PATH=/dev/shm/videos

# Local Telegram Bot API server. The port must match TELEGRAM_HTTP_PORT in
# deploy/telegram-bot-api.service. Use 8081 if you run the Bot API in Docker.
LOCAL_API_URL=http://127.0.0.1:8089
TELEGRAM_HTTP_PORT=8089

REDIS_ADDR=127.0.0.1:6379
DONOR_CHAT_IDS=

MIN_FREE_MEM_MB=256
MAX_FILE_SIZE_MB=2048

# Credentials for the local Bot API server (not the bot itself)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_LOCAL=true
TELEGRAM_STAT=0
TELEGRAM_FILTER=0
TELEGRAM_MAX_WORKERS=1000

# Optional Netscape-format cookies files
#TIKTOK_COOKIES=/opt/envedour-bot/cookies/tiktok.txt
#INSTAGRAM_COOKIES=/opt/envedour-bot/cookies/instagram.txt
#YOUTUBE_COOKIES=/opt/envedour-bot/cookies/youtube.txt

# Optional: override automatic JavaScript runtime detection for yt-dlp.
# Supported runtimes: deno, node (22+), bun (1.2.11+), quickjs.
#YTDLP_JS_RUNTIME=deno:/usr/local/bin/deno

# Telegram chat ID that receives service reminders, e.g. "update the
# Instagram cookies". 0 disables reminders.
ADMIN_CHAT_ID=0

# Anti-spam and resource guards
RATE_LIMIT_JOBS_PER_HOUR=12 # downloads per user per hour (0 = unlimited)
MAX_QUEUE_SIZE=20           # reject new jobs beyond this queue depth (0 = no cap)
MIN_FREE_TMPFS_MB=300       # stop downloading when tmpfs has less free space
PLAYLIST_MAX_ITEMS=50       # cap on YouTube playlist length (0 = no cap)

# Group chats allowed to use the bot (comma-separated IDs; empty = none)
ALLOWED_GROUP_IDS=
